{
  "name": "initiativetracker",
  "private": true,
  "version": "1.0.0",
  "description": "НРИ Трекер Инициативы & Энкаунтеров (TTRPG Initiative Tracker)",
  "author": "Alvetore",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "deploy": "tsc && vite build && npx gh-pages -d dist --nojekyll",
    "icons": "node scripts/generate-icons.mjs",
    "electron:start": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --win portable --config electron-builder.yml",
    "electron:smoke": "npm run build && electron . --smoke",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
